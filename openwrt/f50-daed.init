#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	local dir=/etc/daed
	umask 077
	mkdir -p "$dir" /tmp/log/daed
	/usr/bin/daed validate -c "$dir/" --state "$dir/daed.db" --json > /tmp/log/daed/validate.json 2>&1 || return 1
	procd_open_instance
	procd_set_param command /usr/bin/daed run -c "$dir/" --state "$dir/daed.db" --listen 0.0.0.0:2023
	procd_set_param env NETNS_LINK=veth DAED_PRODUCT_LOG_DIR=/tmp/log/daed
	procd_set_param respawn 3600 5 0
	procd_set_param limits nofile="1048576 1048576"
	procd_close_instance
}
